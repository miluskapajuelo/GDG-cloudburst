# Copy to .env and fill in. Never commit .env.

# --- LLM (B2) ---
GEMINI_API_KEY=
SENTINEL_LLM_MODEL=gemini-3.5-flash-lite
SENTINEL_LLM_TIMEOUT_S=30
# SENTINEL_REPLY_MIN_WORDS=80
# SENTINEL_REPLY_MAX_WORDS=100

# --- API (A2) ---
# 1 = /triage returns shared/fixtures/mock_triage_response.json (no models loaded)
SENTINEL_MOCK=0

# --- paths ---
SENTINEL_DATA_DIR=data
SENTINEL_ARTIFACTS_DIR=artifacts

# --- retrieval (B1) ---
SENTINEL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- gate threshold overrides (B2; defaults live in agent/config.py) ---
# SENTINEL_T_SIM=0.55
# SENTINEL_T_HIGH_PRIORITY_P=0.35
# SENTINEL_T_INCIDENT_P=0.40

# --- web (Team C): put this in web/.env.local instead ---
# VITE_API_URL=http://localhost:8000
